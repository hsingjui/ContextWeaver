{
  "name": "@hsingjui/contextweaver",
  "version": "0.0.7",
  "description": "A context weaving tool for LLMs",
  "license": "MIT",
  "author": "hsingjui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsingjui/ContextWeaver.git"
  },
  "homepage": "https://github.com/hsingjui/ContextWeaver#readme",
  "private": false,
  "type": "module",
  "bin": {
    "contextweaver": "dist/index.js",
    "cw": "dist/index.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --sourcemap --clean && tsc --noEmit",
    "build:release": "tsup src/index.ts --format esm --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm --out-dir dist --sourcemap --watch",
    "fmt": "biome check --write ./src",
    "test": "node --test --import ./tests/setup-env.mjs --import tsx tests/*.test.ts",
    "benchmark:retrieval": "tsx benchmarks/retrieval/run.ts",
    "benchmark:retrieval:compare": "tsx benchmarks/retrieval/compare.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@keqingmoe/tree-sitter": "^0.26.2",
    "@lancedb/lancedb": "^0.38.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "cac": "^7.0.0",
    "chardet": "^2.2.0",
    "dotenv": "^17.4.2",
    "fdir": "^6.5.0",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.8",
    "p-limit": "^7.3.2",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
